{
  "mcpServers": {
    "serena": {
      "command": "uv",
      "args": [
        "run",
        "G:/MCP-Servers/serena/scripts/mcp_server.py"
      ],
      "env": {
        "UV_PYTHON": "",
        "PATH": ""
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "github-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "gitlab-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "searxng-mcp": {
      "command": "node",
      "args": [
        "G:\\MCP-Servers\\searxng-mcp\\dist\\index.js"
      ]
    },
    "android-mcp": {
      "command": "node",
      "args": [
        "G:\\MCP-Servers\\android-mcp\\dist\\index.js"
      ]
    },
    "appium-mcp": {
      "command": "node",
      "args": [
        "G:\\MCP-Servers\\appium-mcp\\dist\\index.js"
      ]
    },
    "apktool-mcp": {
      "command": "uv",
      "args": [
        "run",
        "G:/MCP-Servers/apktool-mcp/apktool_mcp_server.py"
      ]
    },
    "jadx-ai-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "jadx-ai-mcp"
      ]
    },
    "jadx-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "jadx-mcp-server"
      ]
    },
    "autogenesis": {
      "command": "npx",
      "args": [
        "-y",
        "autogenesis"
      ]
    },
    "hyper-v-mcp": {
      "command": "hyperv-mcp",
      "args": []
    },
    "x64dbg-automate-mcp": {
      "command": "x64dbg-automate-mcp",
      "args": []
    },
    "playwright-cli-skills": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ""
      }
    }
  }
}